]<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DigitalZone — تفاصيل المنتج</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#080b12;--surface:#0f1420;--surface2:#161c2e;--border:rgba(255,255,255,0.07);--border2:rgba(255,255,255,0.13);--accent:#3b82f6;--accent2:#6366f1;--text:#f0f2f8;--muted:#7a82a0;--success:#22c55e;}
*{margin:0;padding:0;box-sizing:border-box;}
body{background:var(--bg);color:var(--text);font-family:'IBM Plex Sans Arabic',sans-serif;min-height:100vh;overflow-x:hidden;}

nav{position:sticky;top:0;z-index:100;background:rgba(8,11,18,0.92);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);padding:0 1.5rem;display:flex;align-items:center;justify-content:space-between;height:64px;gap:12px;}
.logo{font-family:'Space Mono',monospace;font-size:18px;color:var(--text);text-decoration:none;flex-shrink:0;}
.logo span{color:var(--accent);}
.nav-right{display:flex;gap:10px;align-items:center;}
.btn-cart{background:var(--surface2);border:1px solid var(--border2);color:var(--text);padding:8px 14px;border-radius:8px;font-size:14px;cursor:pointer;font-family:inherit;display:flex;align-items:center;gap:6px;}
.cart-count{background:var(--accent);color:white;border-radius:50%;width:18px;height:18px;font-size:11px;display:flex;align-items:center;justify-content:center;font-family:'Space Mono',monospace;}
.btn-login-nav{background:linear-gradient(135deg,var(--accent),var(--accent2));color:white;border:none;padding:8px 16px;border-radius:8px;font-size:13px;font-weight:600;font-family:inherit;cursor:pointer;text-decoration:none;display:flex;align-items:center;gap:6px;}
.user-badge{background:var(--surface2);border:1px solid var(--border2);color:var(--text);padding:7px 12px;border-radius:8px;font-size:13px;display:flex;align-items:center;gap:6px;cursor:pointer;position:relative;}
.user-menu{position:absolute;top:calc(100% + 8px);left:0;background:var(--surface);border:1px solid var(--border2);border-radius:10px;padding:6px;min-width:160px;display:none;z-index:200;}
.user-badge:hover .user-menu{display:block;}
.user-menu-item{display:block;padding:9px 12px;color:var(--muted);font-size:13px;border-radius:7px;cursor:pointer;transition:all 0.15s;}
.user-menu-item:hover{background:var(--surface2);color:var(--text);}
.user-menu-item.danger{color:#f87171;}

/* BREADCRUMB */
.breadcrumb{max-width:1100px;margin:0 auto;padding:16px 1.5rem 0;display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);}
.breadcrumb a{color:var(--muted);text-decoration:none;}
.breadcrumb a:hover{color:var(--text);}

/* PRODUCT HERO */
.product-wrap{max-width:1100px;margin:0 auto;padding:24px 1.5rem 48px;display:grid;grid-template-columns:1fr 400px;gap:40px;align-items:start;}
.product-visual{background:var(--surface);border:1px solid var(--border);border-radius:20px;height:320px;display:flex;align-items:center;justify-content:center;font-size:100px;position:relative;overflow:hidden;}
.product-visual::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at center,var(--prod-color,#1a0a0a) 0%,#080b12 100%);}
.product-emoji{position:relative;z-index:1;animation:float-icon 3s ease-in-out infinite;}
@keyframes float-icon{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
.prod-badge{position:absolute;top:16px;right:16px;z-index:2;font-size:12px;padding:4px 12px;border-radius:20px;font-weight:600;}
.prod-badge-hot{background:rgba(239,68,68,0.15);border:1px solid rgba(239,68,68,0.3);color:#f87171;}
.prod-badge-new{background:rgba(34,197,94,0.12);border:1px solid rgba(34,197,94,0.25);color:#4ade80;}

/* PRODUCT INFO */
.product-info{}
.prod-category{font-size:12px;color:var(--muted);letter-spacing:1px;text-transform:uppercase;margin-bottom:8px;}
.prod-name{font-size:32px;font-weight:700;margin-bottom:12px;line-height:1.2;}
.prod-desc{color:var(--muted);font-size:15px;line-height:1.7;margin-bottom:20px;}

/* RATING */
.rating-row{display:flex;align-items:center;gap:8px;margin-bottom:20px;}
.stars{color:#f59e0b;font-size:16px;letter-spacing:2px;}
.rating-num{font-family:'Space Mono',monospace;font-size:14px;font-weight:700;}
.rating-count{font-size:13px;color:var(--muted);}

/* PRICE */
.price-box{background:var(--surface);border:1px solid var(--border2);border-radius:14px;padding:20px;margin-bottom:20px;}
.price-main{display:flex;align-items:baseline;gap:6px;margin-bottom:4px;}
.price-num{font-family:'Space Mono',monospace;font-size:36px;font-weight:700;color:var(--accent);}
.price-period{font-size:14px;color:var(--muted);}
.price-note{font-size:12px;color:var(--success);}

/* FEATURES */
.features-section{margin-bottom:20px;}
.features-title{font-size:14px;font-weight:600;margin-bottom:10px;}
.features-list{display:flex;flex-direction:column;gap:8px;}
.feature-item{display:flex;align-items:center;gap:10px;font-size:14px;}
.feature-check{width:20px;height:20px;background:rgba(34,197,94,0.12);border:1px solid rgba(34,197,94,0.3);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;color:#4ade80;flex-shrink:0;}

/* ACTIONS */
.btn-buy{width:100%;background:linear-gradient(135deg,var(--accent),var(--accent2));color:white;border:none;padding:16px;border-radius:12px;font-size:16px;font-weight:600;font-family:inherit;cursor:pointer;transition:all 0.2s;margin-bottom:10px;display:flex;align-items:center;justify-content:center;gap:8px;}
.btn-buy:hover{filter:brightness(1.1);transform:translateY(-1px);}
.btn-buy.added{background:rgba(34,197,94,0.15);color:#4ade80;border:1px solid rgba(34,197,94,0.3);}
.btn-cart-add{width:100%;background:var(--surface2);border:1px solid var(--border2);color:var(--text);padding:13px;border-radius:12px;font-size:15px;font-weight:500;font-family:inherit;cursor:pointer;transition:all 0.2s;display:flex;align-items:center;justify-content:center;gap:8px;}
.btn-cart-add:hover{border-color:var(--accent);color:var(--accent);}

/* TRUST */
.trust-row{display:flex;gap:16px;margin-top:16px;flex-wrap:wrap;}
.trust-item{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);}

/* TABS */
.tabs-section{max-width:1100px;margin:0 auto;padding:0 1.5rem 48px;}
.tabs-nav{display:flex;gap:0;border-bottom:1px solid var(--border);margin-bottom:28px;}
.tab-btn{background:none;border:none;color:var(--muted);padding:12px 20px;font-size:14px;font-weight:500;font-family:inherit;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px;transition:all 0.2s;}
.tab-btn:hover{color:var(--text);}
.tab-btn.active{color:var(--accent);border-bottom-color:var(--accent);}
.tab-pane{display:none;}
.tab-pane.active{display:block;}

/* REVIEWS */
.reviews-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;}
.big-rating{font-family:'Space Mono',monospace;font-size:48px;font-weight:700;color:var(--accent);}
.review-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px;margin-bottom:12px;}
.review-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;}
.reviewer{display:flex;align-items:center;gap:10px;}
.reviewer-avatar{width:36px;height:36px;background:linear-gradient(135deg,var(--accent),var(--accent2));border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:600;}
.reviewer-name{font-size:14px;font-weight:500;}
.review-date{font-size:12px;color:var(--muted);}
.review-stars{color:#f59e0b;font-size:14px;}
.review-text{font-size:14px;color:var(--muted);line-height:1.6;}

/* RELATED */
.related-section{max-width:1100px;margin:0 auto;padding:0 1.5rem 48px;}
.section-title{font-size:20px;font-weight:600;margin-bottom:20px;}
.related-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;}
.related-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;cursor:pointer;transition:all 0.25s;}
.related-card:hover{transform:translateY(-4px);border-color:var(--border2);box-shadow:0 16px 40px rgba(0,0,0,0.4);}
.related-header{height:100px;display:flex;align-items:center;justify-content:center;font-size:40px;}
.related-body{padding:14px;}
.related-name{font-size:14px;font-weight:600;margin-bottom:4px;}
.related-price{font-family:'Space Mono',monospace;font-size:15px;font-weight:700;color:var(--accent);}

/* TOAST */
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--surface2);border:1px solid var(--border2);color:var(--text);padding:12px 20px;border-radius:10px;font-size:14px;z-index:300;transition:transform 0.3s ease;white-space:nowrap;}
.toast.show{transform:translateX(-50%) translateY(0);}

/* CART OVERLAY */
.cart-overlay{display:none;position:fixed;inset:0;z-index:200;background:rgba(0,0,0,0.7);backdrop-filter:blur(4px);}
.cart-overlay.open{display:flex;}
.cart-panel{background:var(--surface);border-left:1px solid var(--border2);width:380px;max-width:100vw;height:100vh;overflow-y:auto;padding:24px;animation:slideIn 0.3s ease;margin-right:auto;}
@keyframes slideIn{from{transform:translateX(-100%)}to{transform:translateX(0)}}
.cart-title{font-size:20px;font-weight:600;margin-bottom:24px;display:flex;align-items:center;justify-content:space-between;}
.btn-close{background:var(--surface2);border:1px solid var(--border);color:var(--muted);width:32px;height:32px;border-radius:8px;cursor:pointer;font-size:18px;display:flex;align-items:center;justify-content:center;font-family:inherit;}
.cart-item{display:flex;align-items:center;gap:12px;padding:14px 0;border-bottom:1px solid var(--border);}
.cart-item-icon{font-size:28px;flex-shrink:0;}
.cart-item-info{flex:1;min-width:0;}
.cart-item-name{font-size:14px;font-weight:500;}
.cart-item-price{font-size:13px;color:var(--muted);margin-top:2px;}
.btn-remove{background:none;border:none;color:var(--muted);cursor:pointer;font-size:16px;padding:4px;transition:color 0.2s;}
.btn-remove:hover{color:#f87171;}
.qty-controls{display:flex;align-items:center;gap:4px;background:var(--surface2);border:1px solid var(--border2);border-radius:8px;padding:2px 4px;}
.qty-btn{background:none;border:none;color:var(--muted);width:24px;height:24px;cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;border-radius:5px;font-family:inherit;line-height:1;}
.qty-btn:hover{color:var(--text);background:rgba(255,255,255,0.06);}
.qty-num{font-family:'Space Mono',monospace;font-size:13px;color:var(--text);min-width:18px;text-align:center;}
.cart-total{margin-top:24px;padding:16px;background:var(--surface2);border-radius:12px;display:flex;justify-content:space-between;align-items:center;}
.total-label{font-size:14px;color:var(--muted);}
.total-num{font-family:'Space Mono',monospace;font-size:20px;font-weight:700;}
.btn-checkout{width:100%;margin-top:16px;background:linear-gradient(135deg,var(--accent),var(--accent2));color:white;border:none;padding:14px;border-radius:10px;font-size:15px;font-weight:600;font-family:inherit;cursor:pointer;}
.empty-cart{text-align:center;padding:60px 0;color:var(--muted);font-size:14px;}
.empty-cart div{font-size:48px;margin-bottom:16px;}

/* FOOTER */
.site-footer{border-top:1px solid var(--border);padding:40px 1.5rem 0;}
.footer-inner{max-width:1100px;margin:0 auto;}
.footer-top{display:flex;justify-content:space-between;flex-wrap:wrap;gap:32px;margin-bottom:32px;}
.footer-brand .logo-f{font-family:'Space Mono',monospace;font-size:16px;margin-bottom:8px;}
.footer-brand .logo-f span{color:var(--accent);}
.footer-brand p{font-size:12px;color:var(--muted);max-width:200px;line-height:1.6;}
.footer-col h4{font-size:13px;font-weight:600;margin-bottom:12px;}
.footer-col ul{list-style:none;display:flex;flex-direction:column;gap:8px;}
.footer-col a{color:var(--muted);text-decoration:none;font-size:13px;transition:color 0.2s;}
.footer-col a:hover{color:var(--text);}
.footer-divider{height:1px;background:var(--border);margin-bottom:20px;}
.footer-bottom{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;padding-bottom:24px;}
.footer-copy{font-size:12px;color:var(--muted);}
.pay-methods{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
.pay-badge{display:flex;align-items:center;gap:6px;background:white;border-radius:8px;padding:5px 10px;height:32px;}
.pay-badge-applepay{background:#000;}

@media(max-width:768px){
  nav{padding:0 1rem;height:56px;}
  .product-wrap{grid-template-columns:1fr;padding:16px 1rem 32px;gap:24px;}
  .product-visual{height:220px;font-size:72px;}
  .prod-name{font-size:24px;}
  .price-num{font-size:28px;}
  .related-grid{grid-template-columns:repeat(2,1fr);}
  .footer-top{flex-direction:column;}
  .footer-bottom{flex-direction:column;align-items:flex-start;}
}
</style>
</head>
<body>

<nav>
  <a href="/" class="logo">Digital<span>Zone</span></a>
  <div class="nav-right">
    <div id="nav-auth"></div>
    <button class="btn-cart" onclick="openCart()">🛒 سلتي <div class="cart-count" id="cart-count">0</div></button>
  </div>
</nav>

<div class="breadcrumb">
  <a href="/">المتجر</a>
  <span>›</span>
  <span id="bc-name">...</span>
</div>

<div class="product-wrap" id="product-wrap">
  <div style="text-align:center;padding:80px;color:var(--muted);">⏳ جاري التحميل...</div>
</div>

<div class="tabs-section" id="tabs-section" style="display:none;">
  <div class="tabs-nav">
    <button class="tab-btn active" onclick="switchTab('details',this)">التفاصيل</button>
    <button class="tab-btn" onclick="switchTab('reviews',this)">التقييمات</button>
  </div>
  <div class="tab-pane active" id="tab-details"></div>
  <div class="tab-pane" id="tab-reviews"></div>
</div>

<div class="related-section" id="related-section" style="display:none;">
  <div class="section-title">منتجات قد تعجبك</div>
  <div class="related-grid" id="related-grid"></div>
</div>

<div class="cart-overlay" id="cart-overlay" onclick="closeCartOnOverlay(event)">
  <div class="cart-panel">
    <div class="cart-title">سلة المشتريات <button class="btn-close" onclick="closeCart()">✕</button></div>
    <div id="cart-items"></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="logo-f">Digital<span>Zone</span></div>
        <p>متجرك الموثوق للاشتراكات الرقمية بأفضل الأسعار في المملكة</p>
      </div>
      <div class="footer-col"><h4>روابط سريعة</h4><ul><li><a href="/">المتجر</a></li><li><a href="/about.html">من نحن</a></li><li><a href="/contact.html">تواصل معنا</a></li></ul></div>
      <div class="footer-col"><h4>القانونية</h4><ul><li><a href="/terms.html">الشروط والأحكام</a></li><li><a href="/privacy.html">سياسة الخصوصية</a></li><li><a href="/refund.html">سياسة الاسترجاع</a></li></ul></div>
      <div class="footer-col"><h4>الدعم</h4><ul><li><a href="/faq.html">الأسئلة الشائعة</a></li><li><a href="https://wa.me/966500000000" target="_blank">واتساب</a></li></ul></div>
    </div>
    <div class="footer-divider"></div>
    <div class="footer-bottom">
      <div class="footer-copy">© 2025 DigitalZone — جميع الحقوق محفوظة</div>
      <div class="pay-methods">
        <div class="pay-badge pay-badge-applepay"><svg width="40" height="16" viewBox="0 0 165 44" fill="white"><path d="M36.8 7.6c-1.9 2.3-5 4.1-8.1 3.8-.4-3.1 1.1-6.4 2.9-8.4C33.5.7 36.8-1 39.6.4c.4 3.2-1 6.3-2.8 7.2zm2.8 4.5c-4.5-.3-8.3 2.5-10.4 2.5-2.2 0-5.5-2.4-9.1-2.3-4.7.1-9 2.7-11.4 6.9-4.9 8.4-1.3 20.9 3.5 27.7 2.3 3.4 5.1 7.1 8.7 7 3.5-.1 4.8-2.3 9-2.3 4.2 0 5.4 2.3 9.1 2.2 3.8-.1 6.2-3.4 8.5-6.8 2.7-3.9 3.8-7.6 3.8-7.8-.1-.1-7.3-2.8-7.4-11.1-.1-6.9 5.7-10.3 5.9-10.4-3.2-4.7-8.2-5.3-10.2-5.6z"/><path d="M77.8 3.2h-9.2v37.4h5.8V27.3h8c7.3 0 12.5-5 12.5-12.1S85.1 3.2 77.8 3.2zm1.4 19.4h-6.6V8.7h6.6c4.9 0 7.7 2.6 7.7 6.9s-2.8 7-7.7 7zM109.1 40.9c3.6 0 7-.9 9.3-3.5v3.2h5.4V23.4c0-6.1-4.4-10-11.2-10-6.3 0-11 3.5-11.2 8.5h5.3c.4-2.4 2.4-4 5.7-4 3.7 0 5.7 1.9 5.7 5.3v2.4l-7.5.5c-7 .4-10.7 3.4-10.7 8.6 0 5.3 4.2 8.7 9.2 8.2zm1.6-4.5c-3.2 0-5.3-1.6-5.3-4.2 0-2.7 2-4.1 5.9-4.4l6.7-.5v2.3c0 3.9-3.1 6.8-7.3 6.8zM131.4 54c5.7 0 8.3-2.1 10.6-8.6L153 13.7h-5.9l-7.1 23.2-7.8-23.2H126l10.4 28.1-1.1 2.8c-.9 2.5-2.4 3.5-5 3.5h-1.6V54h2.7z"/></svg></div>
        <div class="pay-badge" style="background:#fff;"><svg width="52" height="20" viewBox="0 0 120 44"><text x="10" y="30" font-family="Arial" font-weight="900" font-size="22" fill="#00693e">مدى</text><text x="58" y="30" font-family="Arial" font-weight="900" font-size="18" fill="#007a3d">mada</text></svg></div>
        <div class="pay-badge" style="background:#1a1f71;"><svg width="46" height="16" viewBox="0 0 150 50"><text x="5" y="38" font-family="Arial" font-weight="900" font-size="42" fill="white" letter-spacing="-2">VISA</text></svg></div>
        <div class="pay-badge" style="background:#fff;gap:0;padding:4px 8px;"><svg width="36" height="22" viewBox="0 0 38 24"><circle cx="13" cy="12" r="11" fill="#eb001b"/><circle cx="25" cy="12" r="11" fill="#f79e1b"/><path d="M19 4.8a11 11 0 0 1 0 14.4A11 11 0 0 1 19 4.8z" fill="#ff5f00"/></svg></div>
      </div>
    </div>
  </div>
</footer>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import { getAuth, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";
const app = initializeApp({apiKey:"AIzaSyCF6foh9onJKZu_qHaK_XEX3VJS5b6OVco",authDomain:"digitalzone-6a39a.firebaseapp.com",projectId:"digitalzone-6a39a",storageBucket:"digitalzone-6a39a.firebasestorage.app",messagingSenderId:"607143644878",appId:"1:607143644878:web:9f0e734d2e960511c58a9f"});
const auth = getAuth(app);
onAuthStateChanged(auth, user => {
  const el = document.getElementById('nav-auth');
  if(user){
    const name = user.displayName||user.email||user.phoneNumber||'حسابي';
    const short = name.length>12?name.slice(0,12)+'...':name;
    el.innerHTML=`<div class="user-badge">👤 ${short}<div class="user-menu"><span class="user-menu-item">📦 طلباتي</span><span class="user-menu-item danger" id="logout-btn">تسجيل خروج</span></div></div>`;
    document.getElementById('logout-btn').onclick=()=>signOut(auth);
    window.__firebaseUser=user;
  } else {
    el.innerHTML=`<a href="/login.html" class="btn-login-nav">👤 دخول / تسجيل</a>`;
    window.__firebaseUser=null;
  }
});
</script>

<script>
let products=[], categories=[], cart=[], currentProduct=null;

const REVIEWS = [
  {name:'محمد العتيبي',avatar:'م',stars:5,date:'منذ أسبوع',text:'خدمة ممتازة وتفعيل فوري. أنصح الجميع بالتعامل مع DigitalZone!'},
  {name:'سارة الزهراني',avatar:'س',stars:5,date:'منذ أسبوعين',text:'أسعار رائعة ودعم سريع. استمر يا DigitalZone 👏'},
  {name:'عبدالله القحطاني',avatar:'ع',stars:4,date:'منذ شهر',text:'تجربة شراء سلسة جداً، وصلني الاشتراك في دقائق.'},
  {name:'نورة الشمري',avatar:'ن',stars:5,date:'منذ شهر',text:'أفضل متجر للاشتراكات الرقمية في السعودية بدون منازع!'},
];

async function init() {
  try {
    const [pRes, cRes] = await Promise.all([fetch('/_data/products.json'), fetch('/_data/categories.json')]);
    products = await pRes.json();
    categories = await cRes.json();
  } catch(e) {
    products = FALLBACK_PRODUCTS;
    categories = FALLBACK_CATS;
  }
  const params = new URLSearchParams(location.search);
  const id = parseInt(params.get('id')) || params.get('id');
  currentProduct = products.find(p => p.id == id);
  if (!currentProduct) { document.getElementById('product-wrap').innerHTML = '<div style="text-align:center;padding:80px;color:var(--muted);">المنتج غير موجود</div>'; return; }
  renderProduct(currentProduct);
  renderTabs(currentProduct);
  renderRelated(currentProduct);
  document.title = currentProduct.name + ' — DigitalZone';
  document.getElementById('bc-name').textContent = currentProduct.name;
}

function renderProduct(p) {
  const inCart = cart.find(c=>c.id===p.id);
  document.getElementById('product-wrap').innerHTML = `
    <div>
      <div class="product-visual" style="--prod-color:${p.color||'#1a0a0a'}">
        <div class="product-emoji">${p.icon||'📦'}</div>
        ${p.badge==='hot'?'<div class="prod-badge prod-badge-hot">🔥 رائج</div>':''}
        ${p.badge==='new'?'<div class="prod-badge prod-badge-new">✦ جديد</div>':''}
      </div>
    </div>
    <div class="product-info">
      <div class="prod-category">${getCatLabel(p.category)}</div>
      <div class="prod-name">${p.name}</div>
      <div class="rating-row">
        <div class="stars">★★★★★</div>
        <div class="rating-num">4.9</div>
        <div class="rating-count">(${Math.floor(Math.random()*200+50)} تقييم)</div>
      </div>
      <div class="prod-desc">${p.desc||''}</div>
      <div class="price-box">
        <div class="price-main">
          <div class="price-num">${p.price} ر.س</div>
          <div class="price-period">${p.period||'/شهر'}</div>
        </div>
        <div class="price-note">✓ تفعيل فوري بعد الدفع</div>
      </div>
      ${p.features&&p.features.length?`
      <div class="features-section">
        <div class="features-title">المميزات</div>
        <div class="features-list">
          ${p.features.map(f=>`<div class="feature-item"><div class="feature-check">✓</div>${f}</div>`).join('')}
        </div>
      </div>`:''}
      <button class="btn-buy ${inCart?'added':''}" id="btn-buy" onclick="buyNow(${p.id})">
        ${inCart?'✓ مضاف للسلة':'🛒 أضف للسلة وادفع'}
      </button>
      <button class="btn-cart-add" onclick="addToCartOnly(${p.id})">+ أضف للسلة فقط</button>
      <div class="trust-row">
        <div class="trust-item">🔒 دفع آمن</div>
        <div class="trust-item">⚡ تفعيل فوري</div>
        <div class="trust-item">💬 دعم 24/7</div>
      </div>
    </div>`;
}

function renderTabs(p) {
  document.getElementById('tabs-section').style.display = 'block';
  document.getElementById('tab-details').innerHTML = `
    <div style="color:var(--muted);font-size:15px;line-height:1.8;">${p.desc||''}</div>
    ${p.features&&p.features.length?`<div style="margin-top:20px;"><div style="font-size:15px;font-weight:600;margin-bottom:12px;">المميزات الكاملة</div><div class="features-list">${p.features.map(f=>`<div class="feature-item"><div class="feature-check">✓</div>${f}</div>`).join('')}</div></div>`:''}`;
  document.getElementById('tab-reviews').innerHTML = `
    <div class="reviews-header">
      <div><div class="big-rating">4.9</div><div class="stars" style="font-size:20px;">★★★★★</div><div style="font-size:13px;color:var(--muted);margin-top:4px;">${Math.floor(Math.random()*200+50)} تقييم</div></div>
    </div>
    ${REVIEWS.map(r=>`
    <div class="review-card">
      <div class="review-top">
        <div class="reviewer"><div class="reviewer-avatar">${r.avatar}</div><div><div class="reviewer-name">${r.name}</div><div class="review-date">${r.date}</div></div></div>
        <div class="review-stars">${'★'.repeat(r.stars)}</div>
      </div>
      <div class="review-text">${r.text}</div>
    </div>`).join('')}`;
}

function renderRelated(p) {
  const related = products.filter(x=>x.id!==p.id&&x.category===p.category).slice(0,4);
  if(!related.length) return;
  document.getElementById('related-section').style.display = 'block';
  document.getElementById('related-grid').innerHTML = related.map(r=>`
    <div class="related-card" onclick="window.location.href='/product.html?id=${r.id}'">
      <div class="related-header" style="background:radial-gradient(ellipse at center,${r.color||'#0f0f0f'} 0%,#080b12 100%)">${r.icon}</div>
      <div class="related-body">
        <div class="related-name">${r.name}</div>
        <div class="related-price">${r.price} ر.س<span style="font-size:11px;color:var(--muted);font-family:inherit;"> ${r.period||'/شهر'}</span></div>
      </div>
    </div>`).join('');
}

function getCatLabel(id){const c=categories.find(x=>x.id===id);return c?`${c.icon} ${c.label}`:id;}

function buyNow(id) {
  addToCartOnly(id);
  setTimeout(() => {
    if(!window.__firebaseUser){
      localStorage.setItem('dz_cart',JSON.stringify(cart));
      localStorage.setItem('dz_redirect','/checkout.html');
      window.location.href='/login.html';
      return;
    }
    localStorage.setItem('dz_cart',JSON.stringify(cart));
    window.location.href='/checkout.html';
  }, 300);
}

function addToCartOnly(id) {
  const p=products.find(x=>x.id==id);
  if(!p) return;
  const existing=cart.find(c=>c.id===p.id);
  if(existing){existing.qty=(existing.qty||1)+1;}
  else{cart.push({...p,qty:1});}
  updateCartCount();
  if(currentProduct&&currentProduct.id==id){
    const btn=document.getElementById('btn-buy');
    if(btn){btn.classList.add('added');btn.textContent='✓ مضاف للسلة';}
  }
  showToast(`✓ تم إضافة ${p.name} للسلة`);
}

function switchTab(name, el) {
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
  document.querySelectorAll('.tab-pane').forEach(p=>p.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('tab-'+name).classList.add('active');
}

function updateCartCount(){const total=cart.reduce((s,p)=>s+(p.qty||1),0);document.getElementById('cart-count').textContent=total;}
function removeFromCart(id){cart=cart.filter(c=>c.id!==id);updateCartCount();renderCartItems();}
function updateQty(id,delta){const item=cart.find(c=>c.id===id);if(!item)return;item.qty=(item.qty||1)+delta;if(item.qty<=0){cart=cart.filter(c=>c.id!==id);}updateCartCount();renderCartItems();}

function renderCartItems(){
  const el=document.getElementById('cart-items');
  if(!cart.length){el.innerHTML='<div class="empty-cart"><div>🛒</div>سلتك فارغة</div>';return;}
  const total=cart.reduce((s,p)=>s+(p.price*(p.qty||1)),0);
  el.innerHTML=cart.map(p=>`<div class="cart-item"><div class="cart-item-icon">${p.icon}</div><div class="cart-item-info"><div class="cart-item-name">${p.name}</div><div class="cart-item-price">${p.price*(p.qty||1)} ر.س${p.period}</div></div><div class="qty-controls"><button class="qty-btn" onclick="updateQty(${p.id},-1)">−</button><span class="qty-num">${p.qty||1}</span><button class="qty-btn" onclick="updateQty(${p.id},1)">+</button></div><button class="btn-remove" onclick="removeFromCart(${p.id})">✕</button></div>`).join('')+`<div class="cart-total"><div class="total-label">الإجمالي</div><div class="total-num">${total} ر.س</div></div><button class="btn-checkout" onclick="checkout()">إتمام الشراء →</button>`;
}

function checkout(){
  if(!cart.length)return;
  if(!window.__firebaseUser){localStorage.setItem('dz_cart',JSON.stringify(cart));localStorage.setItem('dz_redirect','/checkout.html');window.location.href='/login.html';return;}
  localStorage.setItem('dz_cart',JSON.stringify(cart));window.location.href='/checkout.html';
}

function openCart(){document.getElementById('cart-overlay').classList.add('open');renderCartItems();}
function closeCart(){document.getElementById('cart-overlay').classList.remove('open');}
function closeCartOnOverlay(e){if(e.target===document.getElementById('cart-overlay'))closeCart();}
function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2500);}

const FALLBACK_PRODUCTS=[{id:1,name:'Netflix',category:'streaming',icon:'🎬',color:'#1a0a0a',badge:'hot',price:29,period:'/شهر',desc:'أفلام ومسلسلات بلا حدود بجودة 4K',features:['4K Ultra HD','4 شاشات','تحميل للجوال']},{id:2,name:'Spotify Premium',category:'music',icon:'🎵',color:'#0a1a0a',badge:'',price:19,period:'/شهر',desc:'موسيقى وبودكاست بدون إعلانات',features:['بدون إعلانات','تحميل أغاني','صوت عالي الجودة']},{id:3,name:'Xbox Game Pass',category:'gaming',icon:'🎮',color:'#0a1a0a',badge:'hot',price:45,period:'/شهر',desc:'مئات الألعاب الأخيرة',features:['+100 لعبة','EA Play مجاناً']}];
const FALLBACK_CATS=[{id:'streaming',label:'مشاهدة',icon:'📺'},{id:'music',label:'موسيقى',icon:'🎵'},{id:'gaming',label:'ألعاب',icon:'🎮'}];

init();
</script>
</body>
</html>
